{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "properties": {
  "meta": {
   "type": "object",
   "properties": {
    "titleMain": {
     "type": "string",
     "description": "Phần chính tên đề tài, IN HOA, ≤ 40 ký tự, có thể xuống dòng bằng \\n (vd 'CHO VAY\\nKHÁCH HÀNG CÁ NHÂN')"
    },
    "titleSub": {
     "type": "string",
     "description": "Phần còn lại của tên đề tài (vd 'tại Ngân hàng … – Chi nhánh Bắc Ninh')"
    },
    "titleFull": {
     "type": "string",
     "description": "Tên đề tài đầy đủ đúng như luận văn"
    },
    "docType": {
     "type": "string",
     "description": "vd 'ĐỀ ÁN TỐT NGHIỆP THẠC SĨ', 'LUẬN VĂN THẠC SĨ'"
    },
    "school": {
     "type": "string"
    },
    "schoolParent": {
     "description": "Cơ quan chủ quản, vd 'BỘ GIÁO DỤC VÀ ĐÀO TẠO · BỘ TÀI CHÍNH'",
     "type": "string"
    },
    "orgName": {
     "type": "string",
     "description": "Tên đầy đủ đơn vị nghiên cứu"
    },
    "orgShort": {
     "type": "string",
     "description": "Tên ngắn, vd 'BIDV Bắc Ninh'"
    },
    "student": {
     "type": "string"
    },
    "supervisor": {
     "type": "string"
    },
    "major": {
     "type": "string"
    },
    "city": {
     "type": "string"
    },
    "year": {
     "type": "string"
    }
   },
   "required": [
    "titleMain",
    "titleSub",
    "titleFull",
    "docType",
    "school",
    "orgName",
    "orgShort",
    "student",
    "supervisor",
    "year"
   ],
   "additionalProperties": false
  },
  "theme": {
   "type": "object",
   "properties": {
    "primary": {
     "type": "string",
     "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "accent": {
     "type": "string",
     "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "mainShape": {
     "type": "string",
     "enum": [
      "diamond",
      "hex",
      "hexTall",
      "slantR",
      "slantL",
      "shard",
      "tab",
      "arrow",
      "blob",
      "circle"
     ],
     "description": "Khung chủ đạo theo quy chuẩn mục 3"
    },
    "subShape": {
     "type": "string",
     "enum": [
      "diamond",
      "hex",
      "hexTall",
      "slantR",
      "slantL",
      "shard",
      "tab",
      "arrow",
      "blob",
      "circle"
     ],
     "description": "Khung phụ"
    },
    "motif": {
     "type": "string",
     "enum": [
      "dynamic",
      "soft"
     ],
     "description": "dynamic = dải chéo + ////; soft = vòng tròn + chấm"
    },
    "rationale": {
     "description": "1 câu lý do chọn màu/khung",
     "type": "string"
    }
   },
   "required": [
    "mainShape",
    "subShape",
    "motif"
   ],
   "additionalProperties": false
  },
  "issues": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "where": {
      "type": "string",
      "description": "Vị trí trong luận văn (bảng/mục/trang)"
     },
     "detail": {
      "type": "string",
      "description": "Mô tả mâu thuẫn, kèm số liệu"
     }
    },
    "required": [
     "where",
     "detail"
    ],
    "additionalProperties": false
   },
   "description": "Số liệu mâu thuẫn phát hiện trong luận văn; [] nếu không có"
  },
